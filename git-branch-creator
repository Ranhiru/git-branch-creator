#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "./utils"
require_relative "./jira_api"
require_relative "./config"

PREFIXES = %w[feat/ fix/ chore/ refactor/ none].freeze
ISSUE_TYPE_DEFAULT_PREFIX = {
  "bug" => "fix/",
  "task" => "chore/",
  "story" => "feat/"
}.freeze

def read_user_input
  input = ARGV.first.to_s
  jira_id = /PRI-\d+/.match(input)

  if jira_id.nil?
    STDERR.puts "Error: Invalid input"
    exit 1
  end

  jira_id.to_s
end

def default_prefix_for_issue_type(issue_type)
  ISSUE_TYPE_DEFAULT_PREFIX.fetch(issue_type.to_s.downcase, "feat/")
end

def select_branch_prefix(default_prefix = "feat/")
  default_index = PREFIXES.index(default_prefix) || 0

  puts "Select branch prefix:"
  PREFIXES.each_with_index do |prefix, index|
    default_marker = index == default_index ? " (default)" : ""
    puts "  #{index + 1}) #{prefix}#{default_marker}"
  end

  print "Enter choice [1-#{PREFIXES.length}]: "
  input = $stdin.gets&.chomp.to_s
  choice = input.empty? ? default_index + 1 : input.to_i

  if choice < 1 || choice > PREFIXES.length
    STDERR.puts "Error: Invalid selection"
    exit 1
  end

  PREFIXES[choice - 1] == "none" ? "" : PREFIXES[choice - 1]
end

def jira_card_details(jira_id)
  config = Config.read_config
  jira_api = JiraApi.new(config)
  jira_api.card_details(jira_id)
end

def generate_branch_name(prefix, jira_id, title)
  unsanitized_branch_name = "#{jira_id} #{title}"
  "#{prefix}#{Utils.sanitize_branch_name(unsanitized_branch_name)}"
end

def create_branch(branch_name)
  puts "Creating #{branch_name}"
  return if system("git", "checkout", "-b", branch_name)

  STDERR.puts "Error: Failed to create branch #{branch_name}"
  exit 1
end

if __FILE__ == $PROGRAM_NAME
  jira_id = read_user_input
  card_details = jira_card_details(jira_id)
  default_prefix = default_prefix_for_issue_type(card_details[:issue_type])
  prefix = select_branch_prefix(default_prefix)
  branch_name = generate_branch_name(prefix, jira_id, card_details[:title])
  create_branch(branch_name)
end
